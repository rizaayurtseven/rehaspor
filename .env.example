# Application
APP_ORIGIN=http://localhost:3000
NODE_ENV=development

# PostgreSQL
# Runtime may use a pooled URL; migrations should use the direct URL when supplied.
DATABASE_URL=postgresql://rehaspor:rehaspor@localhost:5432/rehaspor?schema=public
DIRECT_DATABASE_URL=postgresql://rehaspor:rehaspor@localhost:5432/rehaspor?schema=public

# Authentication
SESSION_COOKIE_NAME=rehaspor_session
SESSION_SECRET=replace-with-at-least-32-random-characters

# Create the first admin once with: npm run admin:create -- --email <email> --password <strong-password>

# S3-compatible object storage (optional until media phase)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Mail adapter (optional; contact messages are saved without it)
MAIL_PROVIDER=
MAIL_FROM=
MAIL_API_KEY=
CONTACT_NOTIFICATION_TO=

# Rate limiting and monitoring (optional until their implementation phases)
RATE_LIMIT_PROVIDER=
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=
ERROR_MONITORING_DSN=
